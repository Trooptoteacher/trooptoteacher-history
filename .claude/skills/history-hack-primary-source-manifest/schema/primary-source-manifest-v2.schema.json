{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trooptoteacher.com/schemas/primary-source-manifest-v2.schema.json",
  "title": "TroopToTeacher Primary-Source Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "course",
    "unit",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "manifest_kind": {
      "enum": ["candidate", "manual_review", "production"]
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "course",
        "unit",
        "standard",
        "asset_type",
        "title",
        "source_page_url",
        "target_filename",
        "drive_subfolder",
        "readiness_tier",
        "review_reason"
      ],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "course": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "standard": {
          "type": "string",
          "pattern": "^(US|GC|TN|W|6|7|8)\\.[0-9]{1,3}[A-Za-z]?$"
        },
        "asset_type": {
          "enum": [
            "image",
            "document",
            "map",
            "cartoon",
            "artifact",
            "audio",
            "video",
            "canonical_html",
            "dataset"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "creator_or_institution": {"type": "string"},
        "date": {"type": "string"},
        "repository": {"type": "string"},
        "exact_item_id": {"type": "string"},
        "source_page_url": {"type": "string", "format": "uri"},
        "direct_download_url": {"type": "string"},
        "delivery_kind": {"enum": ["file", "canonical_html"]},
        "target_filename": {"type": "string", "minLength": 1},
        "drive_subfolder": {"type": "string", "minLength": 1},
        "license": {"type": "string"},
        "rights_basis": {
          "enum": [
            "explicit_public_domain",
            "pre_1929",
            "us_government_work",
            "official_document_text",
            "cc0",
            "cc_by",
            "permission",
            "unresolved"
          ]
        },
        "rights_url": {"type": "string"},
        "attribution": {"type": "string"},
        "commercial_use_ok": {"type": "boolean"},
        "compound_request": {"type": "boolean"},
        "asset_count": {"type": "integer", "minimum": 1},
        "expected_mime_type": {"type": "string"},
        "detected_mime_type": {"type": "string"},
        "retrieval_method": {
          "enum": ["direct_http", "repository_api", "canonical_html", "browser", "none"]
        },
        "retrieval_status": {
          "enum": ["success", "not_tested", "access_blocked", "broken_link", "failed_validation"]
        },
        "retrieval_tested_at": {"type": "string"},
        "source_verified_at": {"type": "string"},
        "http_status": {"type": "integer"},
        "downloaded_bytes": {"type": "integer", "minimum": 0},
        "content_sha256": {"type": "string"},
        "file_signature_valid": {"type": "boolean"},
        "image_width": {"type": ["integer", "null"], "minimum": 1},
        "image_height": {"type": ["integer", "null"], "minimum": 1},
        "verified": {"type": "boolean"},
        "readiness_tier": {"enum": ["GREEN", "YELLOW", "RED"]},
        "review_reason": {"type": "string"},
        "source_warning": {"type": "string"}
      }
    }
  }
}

