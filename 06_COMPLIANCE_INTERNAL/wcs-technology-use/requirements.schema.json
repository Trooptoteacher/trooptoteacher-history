{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WCS Technology Use Guidance — Compliance Requirements Registry",
  "type": "object",
  "required": ["meta", "requirements"],
  "properties": {
    "meta": {"type": "object"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "group", "source", "requirement", "hh_response", "posture", "evidence", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
          "group": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1},
          "hh_response": {"type": "string", "minLength": 1},
          "posture": {"enum": ["meets", "exceeds"]},
          "status": {"enum": ["verified", "declared", "gap"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "ref"],
              "additionalProperties": false,
              "properties": {
                "kind": {"enum": ["doctrine", "repo", "webapp", "webapp_route", "external"]},
                "ref": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
